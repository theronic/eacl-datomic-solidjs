{:paths ["src" "resources"]
 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"}
             "clojars" {:url "https://repo.clojars.org/"}}
 :deps  {org.clojure/clojure            {:mvn/version "1.12.5"}
         org.clojure/data.json          {:mvn/version "2.5.1"}
         org.clojure/tools.logging      {:mvn/version "1.3.0"}
         ring/ring-core                 {:mvn/version "1.11.0"}
         ring/ring-jetty-adapter        {:mvn/version "1.11.0"}
         metosin/reitit-ring            {:mvn/version "0.7.2"}
         ch.qos.logback/logback-classic {:mvn/version "1.4.14"}
         nrepl/nrepl                    {:mvn/version "1.5.2"}
         org.replikativ/konserve-s3     {:mvn/version "0.1.37"}
         ;; The published artifact includes EACL's generated JVM runtime.
         dev.eacl/eacl-datahike         {:mvn/version "8.0.0-SNAPSHOT"}}
 :aliases
 {:dev   {:extra-paths ["dev" "test"]}
  :nrepl {:main-opts  ["-m" "nrepl.cmdline"]}
  :test  {:extra-paths ["test"]
          :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                        ring/ring-mock {:mvn/version "0.4.0"}}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.8"}}
          :ns-default build}
  :run   {:main-opts ["-m" "eacl-datahike-demo.main"]}}}
