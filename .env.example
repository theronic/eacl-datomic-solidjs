# The server reads process environment variables directly. This file is a
# reference only and is never loaded automatically. Never commit real secrets.
EACL_DATAHIKE_DEMO_MODE=development
EACL_DATAHIKE_DEMO_HOST=127.0.0.1
EACL_DATAHIKE_DEMO_PORT=8088
EACL_DATAHIKE_DEMO_STORE_BACKEND=memory
EACL_DATAHIKE_DEMO_REQUEST_TIMEOUT_MS=30000
EACL_DATAHIKE_DEMO_MAX_BODY_BYTES=65536
EACL_DATAHIKE_DEMO_MAX_SEED_SERVERS=1000000
EACL_DATAHIKE_DEMO_SEED_TRANSACTION_SIZE=250
EACL_DATAHIKE_DEMO_SEED_PAUSE_MS=50
EACL_DATAHIKE_DEMO_MAX_COUNT_LIMIT=1000000
EACL_DATAHIKE_DEMO_MAX_EACL_CONCURRENCY=4
EACL_DATAHIKE_DEMO_CACHE_MAX_ENTRIES=512
EACL_DATAHIKE_DEMO_CACHE_PROJECTION_MAX_WEIGHT=4194304
EACL_DATAHIKE_DEMO_CACHE_DENOTATION_MAX_WEIGHT=4194304
EACL_DATAHIKE_DEMO_CACHE_ANSWER_MAX_WEIGHT=16777216
EACL_DATAHIKE_DEMO_CACHE_MANAGED_PROOF_MAX_ATOMS=256

# Optional loopback-only development nREPL.
EACL_DATAHIKE_DEMO_NREPL_PORT=7888

# Durable local file store example:
# EACL_DATAHIKE_DEMO_STORE_BACKEND=file
# EACL_DATAHIKE_DEMO_STORE_ID=00000000-0000-0000-0000-000000000000
# EACL_DATAHIKE_DEMO_STORE_PATH=/absolute/path/to/datahike

# Production S3 example (credentials come from the EC2 instance role):
# EACL_DATAHIKE_DEMO_MODE=production
# EACL_DATAHIKE_DEMO_STORE_BACKEND=s3
# EACL_DATAHIKE_DEMO_STORE_ID=00000000-0000-0000-0000-000000000000
# EACL_DATAHIKE_DEMO_S3_BUCKET=globally-unique-private-bucket
# EACL_DATAHIKE_DEMO_S3_REGION=us-east-1
# EACL_DATAHIKE_DEMO_SECURITY_KEY=replace-with-at-least-32-random-characters
# EACL_DATAHIKE_DEMO_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Local MinIO/S3-compatible origin. Credentials stay in the standard AWS SDK
# environment or profile chain; the application has no custom credential env.
# EACL_DATAHIKE_DEMO_S3_ENDPOINT=http://127.0.0.1:19000
# EACL_DATAHIKE_DEMO_S3_PATH_STYLE_ACCESS=true
