# The server reads ordinary process environment variables. Copy values into
# your shell or local process manager; this file is never loaded automatically.
EACL_SOLIDJS_HOST=0.0.0.0
EACL_SOLIDJS_PORT=8088
EACL_SOLIDJS_DATOMIC_URI=datomic:dev://localhost:4334/eacl-solidjs
EACL_SOLIDJS_REQUEST_TIMEOUT_MS=30000
EACL_SOLIDJS_MAX_BODY_BYTES=1048576
EACL_SOLIDJS_MAX_SEED_SERVERS=100000
EACL_SOLIDJS_MAX_COUNT_LIMIT=1000000
EACL_SOLIDJS_MAX_EACL_CONCURRENCY=4
EACL_SOLIDJS_CACHE_MAX_ENTRIES=512
EACL_SOLIDJS_CACHE_PROJECTION_MAX_WEIGHT=4194304
EACL_SOLIDJS_CACHE_DENOTATION_MAX_WEIGHT=4194304
EACL_SOLIDJS_CACHE_ANSWER_MAX_WEIGHT=16777216
EACL_SOLIDJS_CACHE_MANAGED_PROOF_MAX_ATOMS=256
EACL_SOLIDJS_JETTY_MIN_THREADS=2
EACL_SOLIDJS_JETTY_MAX_THREADS=16
EACL_SOLIDJS_JETTY_MAX_QUEUED_REQUESTS=64

# Required for the durable default. Use a long stable value and never commit a
# real key. The demo derives separate cursor/zed domains from this root key.
EACL_SOLIDJS_SECURITY_KEY=replace-with-a-long-random-development-secret
