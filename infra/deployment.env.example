# Copy to infra/deployment.env (ignored by Git), fill locally, and chmod 600.
# This file contains identifiers and paths, not application secrets.
EACL_AWS_ACCOUNT=000000000000
EACL_AWS_PROFILE=replace-with-aws-cli-profile
EACL_AWS_REGION=us-east-1
EACL_STACK_NAME=eacl-datahike-demo
EACL_BUCKET_NAME=replace-with-globally-unique-bucket
EACL_STORE_ID=00000000-0000-4000-8000-000000000000
EACL_AVAILABILITY_ZONE=us-east-1a
EACL_INSTANCE_TYPE=t4g.medium
EACL_SSH_PUBLIC_KEY=/absolute/path/to/operator-key.pub
EACL_SSH_PRIVATE_KEY=/absolute/path/to/operator-key
EACL_INSTANCE_HOST=replace-after-stack-creation

# Pricing API location labels are separate from AWS region codes.
EACL_PRICING_LOCATION=US East (N. Virginia)
EACL_PUBLIC_IPV4_USAGE_TYPE=USE1-PublicIPv4:InUseAddress

# DNS publication/rollback inputs. DNS_NAME includes the trailing dot used by
# Route53; SITE_ADDRESS is the same hostname without the trailing dot for Caddy.
EACL_HOSTED_ZONE_ID=replace-with-hosted-zone-id
EACL_DNS_NAME=example.com.
EACL_SITE_ADDRESS=example.com
EACL_PREVIOUS_A=192.0.2.10
