[Unit]
Description=EACL v8 Datahike demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eacl-datahike-demo
Group=eacl-datahike-demo
WorkingDirectory=/var/lib/eacl-datahike-demo
EnvironmentFile=/etc/eacl-datahike-demo/eacl-datahike-demo.env
ExecStart=/opt/java/temurin-26/bin/java --enable-native-access=ALL-UNNAMED -Xms256m -Xmx3g -XX:+UseG1GC -XX:NativeMemoryTracking=summary -XX:+ExitOnOutOfMemoryError -jar /opt/eacl-datahike-demo/current
Restart=on-failure
RestartSec=5s
SuccessExitStatus=143
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/eacl-datahike-demo
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
