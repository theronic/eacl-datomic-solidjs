#!/usr/bin/env bash
set -euo pipefail

maintenance_config=/etc/eacl-datahike-demo/Caddyfile.maintenance
active_config=/etc/caddy/Caddyfile
site_address="$(systemctl show caddy --property=Environment --value | tr ' ' '\n' | sed -n 's/^EACL_SITE_ADDRESS=//p' | head -n 1)"

test "$(id -u)" -eq 0 || { echo "run as root" >&2; exit 1; }
[[ "$site_address" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]
test -f "$maintenance_config"
EACL_SITE_ADDRESS="$site_address" caddy validate --config "$maintenance_config"
install -o root -g root -m 0644 "$maintenance_config" "$active_config"
systemctl reload caddy

curl --fail-with-body --silent --show-error --resolve "$site_address:443:127.0.0.1" \
  "https://$site_address/datahike/api/health" --output /tmp/eacl-maintenance-check.json \
  || status=$?
test "${status:-0}" -eq 22
grep -F '"code":"maintenance"' /tmp/eacl-maintenance-check.json >/dev/null
rm -f /tmp/eacl-maintenance-check.json
echo "maintenance mode enabled; the application remains loopback-accessible"
